# ==================================
# Visual Studio & .NET Ignore List
# ==================================

# Visual Studio user-specific files and folders
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# Build results (Crucial for .NET)
[Bb]in/
[Oo]bj/

# Rider / JetBrains tools (if you ever use them)
.idea/

# Mac / Linux system files
.DS_Store
Thumbs.db

# User secrets (Optional but good practice)
appsettings.Development.json